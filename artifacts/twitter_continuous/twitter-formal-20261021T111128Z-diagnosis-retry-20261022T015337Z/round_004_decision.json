      "title": "Reverse WAL group-commit window: commit_delay 100->0, commit_siblings 2->5",
      "anomaly": {
        "metric_id": "telemetry.wal_timing.sync_average_ms",
        "source": "pg_stat_wal / telemetry.wal_timing",
        "measurement_type": "state",
        "unit": "ms",
